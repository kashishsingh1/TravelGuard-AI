              { "color": "green", "value": 0.9 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "title": "Latest Release Confidence",
      "type": "stat",
      "targets": [
        {
          "expr": "travelguard_release_confidence",
          "legendFormat": "Confidence",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "title": "Total Autonomous QA Runs",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(travelguard_test_runs_total)",
          "legendFormat": "Runs",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "title": "Tests Self-Healed",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(travelguard_tests_healed_total)",
          "legendFormat": "Healed",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "title": "Product Defects Detected",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(travelguard_product_defects_total)",
          "legendFormat": "Defects",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 6,
      "title": "Failures by Root Cause Classification",
      "type": "barchart",
      "targets": [
        {
          "expr": "sum by (classification) (travelguard_test_failures_total)",
          "legendFormat": "{{classification}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 7,
      "title": "LLM Requests & Failures by Provider",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (provider) (rate(travelguard_llm_requests_total[5m]))",
          "legendFormat": "Requests - {{provider}}",
          "refId": "A"
        },
        {
          "expr": "sum by (provider) (rate(travelguard_llm_failures_total[5m]))",
          "legendFormat": "Failures - {{provider}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "id": 8,
      "title": "Test Execution Duration Distribution",
      "type": "heatmap",
      "targets": [
        {
          "expr": "sum(rate(travelguard_test_duration_seconds_bucket[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    }
